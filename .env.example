# Default: reviewed local venue sources, read-only, no community reports.
QUIETSPACE_DATA_MODE=curated
# Set mode to supabase for public database reads. Missing/bad config fails closed.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Keep reporting disabled until DB/security/ingress gates pass.
# Never prefix these with NEXT_PUBLIC_, import into client code, or commit values.
SUPABASE_SERVICE_ROLE_KEY=
REPORTS_ENABLED=false
# Exact canonical origin, e.g. https://your-host.example; no trailing slash.
APP_ORIGIN=
# Random secret, at least 32 characters. Never use the SAMPLE test secret.
REPORT_ABUSE_SECRET=
# A single-IP header that your trusted ingress OVERWRITES; no forwarded chains.
# Verify spoofing resistance and block direct origin access before enabling writes.
REPORT_TRUSTED_IP_HEADER=
# Operator CLI only; no application code consumes this.
DATABASE_URL=
NEXT_TELEMETRY_DISABLED=1
